{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minigame-card-duel",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "CardRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CardRoom"] }],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:8000,http://127.0.0.1:8000,https://waceh.github.io"
  },
  "observability": { "enabled": false }
}
